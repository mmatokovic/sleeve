{{ $data := slice }}
{{ $url := "https://gohugo.io/shared/examples/data/books.json" }}
{{ with try (resources.GetRemote $url) }}
  {{ with .Err }}
    {{ warnf "Skipping the books demo: unable to get %s: %s" $url . }}
  {{ else with .Value }}
    {{ $data = . | transform.Unmarshal }}
  {{ end }}
{{ end }}

{{ range $data }}
  {{ $content := dict "mediaType" "text/markdown" "value" .summary }}
  {{ $dates := dict "date" (time.AsTime .date) }}
  {{ $params := dict "author" .author "isbn" .isbn "rating" .rating "genres" .genres }}
  {{ $.AddPage (dict
    "content" $content
    "dates" $dates
    "kind" "page"
    "params" $params
    "path" .title
    "title" .title
  ) }}

  {{ $item := . }}
  {{ with $item.cover }}
    {{ with try (resources.GetRemote .) }}
      {{ with .Err }}
        {{ warnf "Skipping the cover of %q: %s" $item.title . }}
      {{ else with .Value }}
        {{ $.AddResource (dict
          "content" (dict "mediaType" .MediaType.Type "value" .Content)
          "params" (dict "alt" $item.title)
          "path" (printf "%s/cover.%s" $item.title .MediaType.SubType)
        ) }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
